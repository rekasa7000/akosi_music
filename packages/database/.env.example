# Local dev Postgres, started via `docker compose up -d` at the repo root.
DATABASE_URL="postgresql://akosi:akosi@localhost:5432/akosi"

# Only used by `pnpm seed` — bootstraps the one admin account with a
# temporary, shared credential (deliberately not an email address).
# Fails loudly on a second run if an admin already exists. The real
# admin replaces both on first login — see docs/12-admin-authentication.md.
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD="change-me"
