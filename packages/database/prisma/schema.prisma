generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FAN
  ARTIST
  ADMIN
}

enum ReleaseVisibility {
  PUBLIC
  PRIVATE
}

enum TrackMediaType {
  AUDIO
  VIDEO
}

enum TrackStatus {
  PROCESSING
  READY
  FAILED
}

enum CardStatus {
  UNCLAIMED
  CLAIMED
  REVOKED
}

enum AdminAuthChallengeType {
  EMAIL_VERIFICATION
  PASSWORD_SETUP
  TOTP_ENROLLMENT
  LOGIN_MFA
}

enum AdminAuthChallengeMethod {
  EMAIL
  TOTP
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         UserRole @default(FAN)
  // Phase 0: set for ADMIN users (admin login). Null for others until
  // fan auth is designed. See docs/11-mvp-phase0.md.
  passwordHash String?
  // Admin MFA (docs/12-admin-authentication.md). emailVerifiedAt is a
  // one-time gate, set on first successful email verification.
  // passwordSetAt is set once the bootstrap password is replaced —
  // tracked separately from emailVerifiedAt/totpConfirmedAt so a login
  // interrupted mid-setup can resume at the exact right step instead
  // of re-deriving it from two flags that don't uniquely determine
  // which step is next. totpSecret is encrypted at rest and written at
  // enrollment time, before confirmation — totpConfirmedAt is what
  // says it's trusted.
  emailVerifiedAt DateTime?
  passwordSetAt   DateTime?
  totpSecret      String?
  totpConfirmedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artist              Artist?
  cardOwnerships      CardOwnership[]
  playEvents          PlayEvent[]
  adminAuthChallenges AdminAuthChallenge[]

  @@map("users")
}

model AdminAuthChallenge {
  id         String                    @id @default(cuid())
  userId     String
  type       AdminAuthChallengeType
  // Implied by type for EMAIL_VERIFICATION/TOTP_ENROLLMENT; chosen by
  // the admin for LOGIN_MFA.
  method     AdminAuthChallengeMethod?
  // High-entropy opaque bearer value returned to the client — not the
  // row id, so leaking a log line with the id doesn't leak a usable
  // token.
  token      String                    @unique
  // Hashed OTP (argon2) — only set when method = EMAIL. TOTP codes are
  // verified live against User.totpSecret, nothing stored here.
  codeHash   String?
  // EMAIL_VERIFICATION only. The admin-submitted real email, pending
  // confirmation — User.email is only overwritten once this is
  // verified, so a typo or abandoned flow can't lock the bootstrap
  // account out (see docs/12-admin-authentication.md).
  pendingEmail String?
  attempts   Int                       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("admin_auth_challenges")
}

model Artist {
  id         String    @id @default(cuid())
  // Phase 0: nullable — admin creates artist profiles without a live
  // account; backfilled once self-serve artist signup ships. The
  // profile fields below are deliberately flat (not a separate
  // "ArtistProfile" table) so that when self-serve login exists, the
  // same PATCH /admin/artists/:id shape becomes PATCH /artist/profile
  // scoped by this row's userId instead of an admin session — no
  // migration needed, just a different auth guard.
  userId     String?   @unique
  name       String
  slug       String    @unique
  bio        String?
  // Profile fields — modeled on what Spotify exposes as
  // artist-editable (image, header image, bio, external links), minus
  // "followers," which needs a real fan-follow relationship this
  // system doesn't have yet. See docs/11-mvp-phase0.md.
  profileImageKey String?
  coverImageKey   String?
  websiteUrl      String?
  instagramUrl    String?
  twitterUrl      String?
  facebookUrl     String?
  spotifyUrl      String?
  invitedAt  DateTime  @default(now())
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  releases Release[]
  cards    Card[]

  @@map("artists")
}

model Release {
  id         String            @id @default(cuid())
  artistId   String
  title      String
  releasedAt DateTime?
  // Phase 0 additions — see docs/11-mvp-phase0.md.
  visibility ReleaseVisibility @default(PUBLIC)
  // Set only when visibility = PRIVATE; hashed, never returned by any
  // API response.
  passwordHash   String?
  coverImageKey  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  artist Artist  @relation(fields: [artistId], references: [id])
  tracks Track[]
  cards  Card[]

  @@map("releases")
}

model Track {
  id          String         @id @default(cuid())
  releaseId   String
  title       String
  durationSec Int?
  trackNumber Int?
  // Phase 0 additions — see docs/11-mvp-phase0.md.
  mediaType     TrackMediaType @default(AUDIO)
  lyrics        String?
  coverImageKey String?
  status               TrackStatus @default(PROCESSING)
  rawStorageKey        String?
  processedStorageKey  String?
  failureReason        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  release    Release     @relation(fields: [releaseId], references: [id])
  playEvents PlayEvent[]
  cards      Card[]

  @@map("tracks")
}

model Card {
  id              String     @id @default(cuid())
  // Phase 0.5: cards are manufactured manually, so there's no real
  // NFC UID to read yet — uid doubles as the code the admin types in
  // when provisioning the card and that a fan enters (or that's baked
  // into the tap URL printed/encoded on the card) to redeem it. Real
  // NFC auth replaces what proves possession of this value, not the
  // value's role (see docs/11-mvp-phase0.md's convergence table).
  // Stored in plaintext, not hashed, by necessity: the admin must be
  // able to read it back to match a row to the physical card in hand
  // (unlike a login password, it's never "entered once and forgotten"
  // — it's a durable label on an object, closer to an API key than a
  // password). Treat DB access and backups with the same care as any
  // other credential store; a leaked code is revoked by setting that
  // row's status to REVOKED and provisioning a new card with a new
  // code, not by editing this field.
  uid             String     @unique
  artistId        String
  // null = Artist Card (unused by Phase 0.5's manual flow, reserved
  // for a future album-level card).
  releaseId       String?
  // Set = Music Card for one track — the Phase 0.5 case: a track with
  // at least one non-REVOKED card pointing at it is private, and any
  // of those cards' uid unlocks it. Multiple cards can point at the
  // same track (editionLabel distinguishes them) so a limited run of
  // physical variants can all redeem the same song.
  trackId         String?
  status          CardStatus @default(UNCLAIMED)
  lastSeenCounter Int        @default(0)
  editionLabel    String?
  provisionedAt   DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  artist    Artist         @relation(fields: [artistId], references: [id])
  release   Release?       @relation(fields: [releaseId], references: [id])
  track     Track?         @relation(fields: [trackId], references: [id])
  ownership CardOwnership?
  playEvents PlayEvent[]

  @@map("cards")
}

model CardOwnership {
  id        String   @id @default(cuid())
  cardId    String   @unique
  userId    String
  claimedAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("card_ownerships")
}

model PlayEvent {
  id       String   @id @default(cuid())
  // Phase 0: nullable — no cards exist yet. See docs/11-mvp-phase0.md.
  cardId   String?
  // Phase 0: required — the play/view target in the absence of a card.
  trackId  String
  // Phase 0: nullable — no fan accounts yet.
  userId   String?
  playedAt DateTime @default(now())

  card  Card? @relation(fields: [cardId], references: [id])
  track Track @relation(fields: [trackId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@map("play_events")
}
