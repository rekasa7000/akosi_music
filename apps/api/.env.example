PORT=4000
NODE_ENV=development

# Unauthenticated storage-wiring demo routes (/uploads/presign,
# /uploads/playback-url) are hard-disabled unless BOTH NODE_ENV is
# exactly "development" AND this is explicitly "true". Never set this
# outside local dev. See docs/11-mvp-phase0.md.
ENABLE_DEV_UPLOAD_ROUTES=true

DATABASE_URL="postgresql://akosi:akosi@localhost:5432/akosi"

# S3 (LocalStack in dev — docker compose up -d at the repo root).
# Unset S3_ENDPOINT in prod to talk to real AWS S3 directly.
S3_ENDPOINT="http://localhost:4566"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="akosi"
S3_SECRET_ACCESS_KEY="akosi-dev-secret"
S3_BUCKET_RAW="akosi-raw"
S3_BUCKET_MEDIA="akosi-media"

# Admin auth (docs/12-admin-authentication.md). JWT_SECRET and
# TOTP_ENCRYPTION_KEY are real secrets — generate your own, never
# reuse the example values, and move both to a real secrets
# manager/KMS before any real deployment (04-tech-stack.md).
JWT_SECRET="generate-a-random-secret"
# 32 raw bytes, base64-encoded. Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# SMTP — Mailpit in dev (docker compose up -d), a real provider in prod.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="Akosi Admin <admin@akosi.local>"
